      "required": true,
      "default": "Widget"
    },
    "customer": {
      "type": "text",
      "name": "customer",
      "display-name": "Customer",
      "id": "5d0f1a4e-1c1b-4d3e-9a51-0b6f6e2a1002"
    }
  },
